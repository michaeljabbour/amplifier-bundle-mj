// Occam's Machete — bundle composition diagram (v3 convention)
// Hand-authored following the bundle-to-dot v3 convention (bundle_repo_dot API
// not present in this foundation build). Regenerate with `generate-bundle-docs`
// once amplifier_foundation.bundle_docs is available.
digraph occams_machete {
  rankdir=TB;
  graph [source_hash="9f41da4ffe68e2ec", fontname="Helvetica", labelloc="t",
         label="Occam's Machete — a code-and-prose reduction bundle\n(skill · agent · /machete mode · recipes)", fontsize=16, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=11, style="filled", shape="box", color="#37474f"];
  edge  [fontname="Helvetica", fontsize=9, color="#546e7a"];

  // ---- Root bundle -------------------------------------------------------
  root [label="bundle.md\n(occams-machete)\nthin router", fillcolor="#80cbc4", shape="box3d"];

  // ---- External dependencies (dashed; cost borne upstream) ---------------
  subgraph cluster_external {
    label="External (composed, cost upstream)"; style="filled"; fillcolor="#f9f9f9"; fontsize=10;
    foundation [label="amplifier-foundation\n(filesystem, bash, grep, LSP…)", fillcolor="#f5f5f5", style="filled,dashed", color="red"];
    modes_beh  [label="amplifier-bundle-modes\nbehaviors/modes.yaml", fillcolor="#f5f5f5", style="filled,dashed", color="red"];
  }

  // ---- Behaviors cluster -------------------------------------------------
  subgraph cluster_behaviors {
    label="Behaviors"; style="filled"; fillcolor="#f9f9f9"; fontsize=10;
    behavior [label="behaviors/occams-machete.yaml\nwires it all together", fillcolor="#e0f2f1"];
  }

  // ---- Agents cluster ----------------------------------------------------
  subgraph cluster_agents {
    label="Agents"; style="filled"; fillcolor="#f9f9f9"; fontsize=10;
    agent [label="agents/occams-machete.md\nthe executioner\n(edits · tests · body count)", fillcolor="#c8e6c9"];
  }

  // ---- Skills (the judgment) --------------------------------------------
  subgraph cluster_skills {
    label="Skills"; style="filled"; fillcolor="#f9f9f9"; fontsize=10;
    skill [label="skills/occams-machete/SKILL.md\nthe persona + discipline", fillcolor="#e1bee7"];
  }

  // ---- Modes (the posture) ----------------------------------------------
  subgraph cluster_modes {
    label="Modes"; style="filled"; fillcolor="#f9f9f9"; fontsize=10;
    mode [label="modes/machete.md\n/machete — reduction posture\n(subtraction-biased tool gates)", fillcolor="#fff9c4"];
  }

  // ---- Recipes (the orchestration) --------------------------------------
  subgraph cluster_recipes {
    label="Recipes"; style="filled"; fillcolor="#f9f9f9"; fontsize=10;
    r_reduce [label="recipes/reduce-target.yaml\nbaseline → cut → verify", fillcolor="#ffe0b2"];
    r_panel  [label="recipes/panel-then-cut.yaml\nreview → APPROVAL GATE → cut", fillcolor="#ffe0b2"];
  }

  // ---- Context cluster ---------------------------------------------------
  subgraph cluster_context {
    label="Context Files"; style="filled"; fillcolor="#f9f9f9"; fontsize=10;
    ctx [label="context/machete-awareness.md\nroot-session routing", fillcolor="#e1bee7"];
  }

  // ---- Modules / tools (wired by the behavior) --------------------------
  subgraph cluster_modules {
    label="Modules / Tools"; style="filled"; fillcolor="#f9f9f9"; fontsize=10;
    t_skills  [label="tool-skills",  fillcolor="#bbdefb"];
    t_mode    [label="tool-mode",    fillcolor="#bbdefb"];
    h_mode    [label="hooks-mode",   fillcolor="#bbdefb"];
    t_recipes [label="tool-recipes", fillcolor="#bbdefb"];
  }

  // ---- Composition edges -------------------------------------------------
  root -> foundation [style="dashed", color="red", label="includes"];
  root -> behavior   [label="includes"];
  behavior -> modes_beh [style="dashed", color="red", label="includes"];

  behavior -> agent [label="agents.include"];
  behavior -> ctx   [label="context.include"];
  behavior -> t_skills  [label="tools"];
  behavior -> t_mode    [label="tools"];
  behavior -> h_mode    [label="hooks"];
  behavior -> t_recipes [label="tools"];

  t_skills  -> skill [style="dotted", label="loads"];
  h_mode    -> mode  [style="dotted", label="search_paths"];
  t_recipes -> r_reduce [style="dotted", label="runs"];
  t_recipes -> r_panel  [style="dotted", label="runs"];

  agent -> skill [style="dotted", label="load_skill"];
  mode  -> skill [style="dotted", label="load_skill"];
  r_reduce -> agent [style="dotted", label="delegates"];
  r_panel  -> agent [style="dotted", label="delegates"];

  // ---- Legend ------------------------------------------------------------
  subgraph cluster_legend {
    label="Legend"; style="filled"; fillcolor="#eceff1"; fontsize=10;
    L1 [label="root bundle", fillcolor="#80cbc4"];
    L2 [label="behavior",    fillcolor="#e0f2f1"];
    L3 [label="agent",       fillcolor="#c8e6c9"];
    L4 [label="skill / context", fillcolor="#e1bee7"];
    L5 [label="module / tool",   fillcolor="#bbdefb"];
    L6 [label="external (cost upstream)", fillcolor="#f5f5f5", style="filled,dashed", color="red"];
    L1 -> L2 -> L3 -> L4 -> L5 -> L6 [style="invis"];
  }
}
