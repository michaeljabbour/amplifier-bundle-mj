        agt_mj_reviewer [label="MJ Reviewer\nArchitectural judgment: is the shape right?\n~196 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
        agt_occams_machete [label="Occam's Machete\nDecisive reducer: cuts the bloat, safely\n~113 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
    }

    subgraph cluster_modules {
        label="Modules — supporting code"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

